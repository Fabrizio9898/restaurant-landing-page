---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const categories = Array.from(new Set(site.menu.map((i) => i.category)));
---

<Layout title={`Menú — ${site.name}`}>
	<Header />
	<main class="pt-28 bg-(--color-cream) min-h-screen">
		<section class="section-pad">
			<div class="section-inner">
				<p class="section-label">Carta completa</p>
				<h1 class="section-title">Menú</h1>

				{categories.map((cat) => (
					<div class="mt-14">
						<h2 class="font-serif text-2xl text-(--color-wood-dark) mb-6 border-b border-(--color-wood)/15 pb-2">{cat}</h2>
						<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{site.menu.filter((i) => i.category === cat).map((item) => (
								<li class="border border-(--color-wood)/15 bg-white p-5 hover:border-(--color-gold)/40 transition-colors">
									<div class="flex items-start justify-between gap-3">
										<h3 class="font-serif text-lg">{item.name}</h3>
										<span class="text-sm text-(--color-gold) whitespace-nowrap">{item.price}</span>
									</div>
									<p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.description}</p>
								</li>
							))}
							</ul>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</Layout>
