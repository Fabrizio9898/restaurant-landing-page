---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReservationFlow from '../components/reservation/ReservationFlow.astro';
import { site } from '../data/site';
---

<Layout title={`Reservas — ${site.name}`}>
	<main class="pt-28 bg-(--color-cream) min-h-screen">
		<section class="section-pad">
			<div class="section-inner">
				<p class="section-label">Mesas</p>
				<h1 class="section-title">Reservá tu mesa</h1>
				<p class="mt-4 text-(--color-wood-dark) leading-relaxed">
					Elegí el día, sumá tus platos con descuento y confirmá tu reserva.
				</p>
				<div class="mt-10">
					<ReservationFlow />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
