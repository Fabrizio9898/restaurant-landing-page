---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import EventsHero from '../components/EventsHero.astro';

import PantallaIcon from '../components/icons/PantallaIcon.astro';
import DroneIcon from '../components/icons/DroneIcon.astro';
import FotoIcon from '../components/icons/FotoIcon.astro';
import SonidoIcon from '../components/icons/SonidoIcon.astro';
import IluminacionIcon from '../components/icons/IluminacionIcon.astro';
import EfectosIcon from '../components/icons/EfectosIcon.astro';

const serviciosAdicionales = [
  { Icono: PantallaIcon, titulo: 'PANTALLA', descripcion: 'Proyector y pantalla gigante' },
  { Icono: DroneIcon, titulo: 'DRONES', descripcion: 'Cobertura aérea profesional' },
  { Icono: FotoIcon, titulo: 'FOTOGRAFÍA Y VIDEO', descripcion: 'Capturamos cada momento' },
  { Icono: SonidoIcon, titulo: 'SONIDO PROFESIONAL', descripcion: 'Equipos de alta calidad' },
  { Icono: IluminacionIcon, titulo: 'ILUMINACIÓN ESPECIAL', descripcion: 'Ambientación a medida' },
  { Icono: EfectosIcon, titulo: 'EFECTOS ESPECIALES', descripcion: 'Humo, fuegos fríos y más' }
];

const caracteristicasPrincipales = [
  { icono: 'capacidad', titulo: 'CAPACIDAD', descripcion: '70 a 160 personas' },
  { icono: 'catering', titulo: 'CATERING', descripcion: 'Menú y servicio completo' },
  { icono: 'horarios', titulo: 'HORARIOS', descripcion: 'Eventos de día o de noche' },
];
---

<Layout>
  <Header />

  <EventsHero />

  <main class="w-full">

    <!-- INTRODUCCIÓN -->
    <section class="w-full pt-20 pb-16 px-6 md:px-12 lg:px-16">
      <div class="w-full text-center">
        <p class="text-black leading-relaxed text-lg md:text-xl font-semibold">
          Los salones de eventos en Uribelarrea son el escenario ideal para sus celebraciones, desde una reunión familiar íntima hasta una gran gala. Nuestros espacios combinan carácter histórico y comodidad. Nos ocupamos de cada detalle del menú, el armado y el servicio. Usted solo disfrute y relájese.
        </p>
      </div>
    </section>


    <!-- EXPERIENCIAS / SALONES -->
    <section class="w-full px-6 md:px-12 lg:px-16 pb-24 flex flex-col gap-24">

      <!-- Fila 1 -->
      <article class="w-full flex flex-col md:flex-row items-center gap-10">
        <div class="w-full md:w-1/2">
          <img src="/photos/evento1.webp" alt="Boda en el restaurante" class="w-full h-87.5 md:h-112.5 object-cover" />
        </div>
        <div class="w-full md:w-1/2 md:pl-10 md:border-l-2 border-gray-800 text-center md:text-left">
          <h3 class="uppercase tracking-widest mb-6 text-2xl text-gray-900">
            Su boda en nuestro salón
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Deje que nuestro especialista personal de bodas se encargue de todos los detalles, sean las invitaciones, las flores o todo lo demás, para que usted disfrute de su día en nuestro jardín privado, perfecto para su ceremonia.
          </p>
        </div>
      </article>

      <!-- Fila 2 -->
      <article class="w-full flex flex-col md:flex-row-reverse items-center gap-10">
        <div class="w-full md:w-1/2">
          <img src="/photos/evento2.webp" alt="Servicio personalizado" class="w-full h-87.5 md:h-112.5 object-cover" />
        </div>
        <div class="w-full md:w-1/2 md:pr-10 md:border-r-2 border-gray-800 text-center md:text-right">
          <h3 class="uppercase tracking-widest mb-6 text-2xl text-gray-900">
            Servicio Personalizado
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Nuestro profesional equipo siempre está a su disposición para que sus invitados sean atendidos como se merecen. Ya sea un auténtico asado al estilo argentino en nuestro jardín, nosotros nos aseguramos de que todo salga a la perfección.
          </p>
        </div>
      </article>

      <!-- Fila 3 -->
      <article class="w-full flex flex-col md:flex-row items-center gap-10">
        <div class="w-full md:w-1/2">
          <img src="/photos/evento3.webp" alt="Salones exclusivos" class="w-full h-87.5 md:h-112.5 object-cover" />
        </div>
        <div class="w-full md:w-1/2 md:pl-10 md:border-l-2 border-gray-800 text-center md:text-left">
          <h3 class="uppercase tracking-widest mb-6 text-2xl text-gray-900">
            Salones Exclusivos
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Desde amplias terrazas a jardines privados, nuestros originales salones le dan mayor categoría a cualquier ocasión. Estos entornos se pueden configurar exactamente según sus especificaciones.
          </p>
        </div>
      </article>

    </section>


    <!-- SERVICIOS ADICIONALES -->
    <section class="w-full bg-[#fdfaf6] py-12 md:py-14 px-6 md:px-12 lg:px-16 border-t border-gray-200">
      <div class="w-full flex flex-col items-center gap-12 md:gap-16">

        <!-- Títulos -->
        <div class="text-center">
          <h2 class="text-xl md:text-2xl tracking-[0.2em] uppercase text-gray-800 font-light mb-2">
            Servicios Adicionales
          </h2>
          <p class="text-gray-500 italic">
            Para que tu evento sea aún más especial
          </p>
        </div>

        <!-- Servicios -->
        <div class="w-full lg:max-w-5xl grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-wrap lg:justify-center gap-y-10 gap-x-4 lg:gap-x-12 lg:gap-y-14">
          {serviciosAdicionales.map((servicio) => (
            <article class="flex flex-col items-center text-center px-2 lg:w-40">
              <div
                class="w-16 h-16 mb-4 flex items-center justify-center rounded-full"
                style="border: 1px solid var(--border-accent);"
              >
                <servicio.Icono class="w-16 h-16 text-gray-700 opacity-80" />
              </div>

              <h3
                class="text-xs md:text-sm uppercase mb-2"
                style="letter-spacing: var(--tracking-label); color: var(--color-black); font-weight: 500;"
              >
                {servicio.titulo}
              </h3>

              <p class="text-sm leading-snug" style="color: var(--color-blue-light);">
                {servicio.descripcion}
              </p>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- CTA WHATSAPP -->
    <section class="w-full py-10 px-6 md:px-12 lg:px-16" style="background: var(--color-cream); border-top: 1px solid var(--border-light);">
      <div class="w-full mx-auto flex flex-col md:flex-row items-center justify-center gap-6 md:gap-10 text-center">

        <p
          class="text-[length:var(--font-size-body)] md:text-[length:var(--font-size-body-lg)]"
          style="font-family: var(--font-serif); font-style: italic; color: var(--color-black);"
        >
          Nuestro personal experto puede ayudarle a planear su evento.
        </p>

        <a
          href="https://wa.me/5491143211200"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          style="background: var(--color-blue); border-color: var(--color-blue); color: var(--color-white); flex-shrink: 0;"
        >
          Comuníquese con nosotros
        </a>

      </div>
    </section>

  </main>

  <Footer />
</Layout>