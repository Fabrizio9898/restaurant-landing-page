---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Menu from '../components/Menu.astro';
import Discover from '../components/Discover.astro';
import Location from '../components/Location.astro';
import Reservas from '../components/Reservas.astro';
import Footer from '../components/Footer.astro';
import FloatingReserve from '../components/FloatingReserve.astro';
---

<Layout>
	<Header />
<main class="flex flex-col ">

		<Hero />
		<About videoSrc="/videos/video.mp4"
  videoPoster="/images/poster.jpg"
  image1="/photos/plato1.webp"
  image2="/photos/plato2.webp"
  title="Único en Uribelarrea"
  text="Descubrí la experiencia gastronómica que combina tradición y modernidad en cada plato. Nuestro restaurante ofrece un ambiente acogedor y una cocina de autor que deleita todos los sentidos."
  buttonLabel="Reservar mesa"
  buttonHref="/reservas"/>
		<Discover />

  <Menu />
		<Location />
		<Reservas />
	</main>
	<Footer />
	<FloatingReserve />
</Layout>
