---
import { site } from '../data/site';
import Logo from '../assets/logo.svg';
const links = [
  { href: '/#about', label: 'Sobre nosotros', id: 'about' },
  { href: '/galeria-fotos', label: 'Galería', id: 'galeria' },
    { href: '/menu', label: 'Menú', id: 'menu' },
  { href: '/#location', label: 'Ubicación', id: 'location' },
];
const isHome = Astro.url.pathname === '/';
---

<header
  id="main-header"
  class="fixed top-0 left-0 z-50 w-full bg-white/80 backdrop-blur-sm text-black border-b border-(--color-wood)/15 transition-all duration-400 h-20"
>
  <div class="relative z-50 mx-auto px-5 2xl:px-15 h-full flex items-center justify-between">
    <!-- Logo -->
 <a href="/" class="flex items-center gap-2 relative z-50 shrink-0" aria-label={site.shortName}>
  <Logo class="h-10 md:h-14 w-auto text-black fill-current" />
</a>

    <!-- Nav Desktop -->
    <nav class="hidden lg:flex items-center gap-10">
      <ul class="flex items-center gap-8 text-xs uppercase tracking-[0.2em] font-medium text-(--color-wood-dark)">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link={l.id}
              class="nav-link whitespace-nowrap hover:text-black transition-colors duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)] py-2 relative after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-px after:bg-(--color-gold) after:transition-all after:duration-750 after:ease-[cubic-bezier(0.215,0.61,0.355,1)] hover:after:w-full is-active:after:w-full"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
     
    </nav>

    <!-- Botón Hamburguesa -->
    <button
      class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none relative z-50"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Abrir menú"
      id="hamburger-btn"
      type="button"
    >
      <span class="w-7 h-[1.5px] bg-black transition-transform duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)] origin-center" id="line1"></span>
      <span class="w-7 h-[1.5px] bg-black transition-transform duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)] origin-center" id="line2"></span>
    </button>
  </div>
</header>


<nav
  id="nav-menu"
  aria-label="Menú de navegación móvil"
  class="lg:hidden fixed inset-0 w-full h-dvh bg-white z-40 px-[10vw] pt-25 pb-10 flex flex-col overflow-y-auto overscroll-contain"
>
  <!-- Contenedor interno para manejar el flexbox sin romper márgenes -->
  <div class="flex flex-col flex-1 min-h-full w-full justify-center gap-16 min-[450px]:flex-row min-[450px]:justify-between min-[450px]:items-center min-[450px]:gap-8">

   
    <ul class="flex flex-col gap-[clamp(20px,4vh,40px)] text-[clamp(28px,4vw,55px)] leading-none font-serif text-black w-full">
      {links.map((l) => (
        <li class="nav__item opacity-0 translate-y-8 transition-all duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)]">
          <a href={l.href} data-nav-link={l.id} class="mobile-link block w-full">{l.label}</a>
        </li>
      ))}
      <li class="nav__item opacity-0 translate-y-8 transition-all duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)] mt-4">
        <a href="/reservas" class="mobile-link text-(--color-gold) block w-full">Reservar</a>
      </li>
    </ul>

    <ul class="social-menu opacity-0 translate-y-8 transition-all duration-750 ease-[cubic-bezier(0.215,0.61,0.355,1)] flex flex-col gap-4 text-[clamp(20px,2.25vw,27px)] leading-tight font-light text-zinc-600 max-[450px]:self-end ">
      <li><a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="mobile-link hover:text-(--color-gold) transition-colors">Instagram</a></li>
      <li><a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="mobile-link hover:text-(--color-gold) transition-colors">Facebook</a></li>
      <li><a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" class="mobile-link hover:text-(--color-gold) transition-colors">TikTok</a></li>
    </ul>
  </div>
</nav>

<style>
  /* --- Animación Premium de Entrada (Estilo Onyx) --- */
  #nav-menu {
    clip-path: inset(50% 10% 50% 10% round 15%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: clip-path 0.75s cubic-bezier(0.215, 0.61, 0.355, 1),
                opacity 0.75s cubic-bezier(0.215, 0.61, 0.355, 1),
                visibility 0.75s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  /* Estado Abierto (controlado por clase en el nav) */
  #nav-menu.is-open {
    clip-path: inset(0 0 0 0 round 0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  /* Cascada de animaciones para los links */
  #nav-menu.is-open .nav__item {
    opacity: 1;
    transform: translateY(0);
  }

  #nav-menu.is-open .nav__item:nth-child(1) { transition-delay: 0.1s; }
  #nav-menu.is-open .nav__item:nth-child(2) { transition-delay: 0.15s; }
  #nav-menu.is-open .nav__item:nth-child(3) { transition-delay: 0.2s; }
  #nav-menu.is-open .nav__item:nth-child(4) { transition-delay: 0.25s; }
  #nav-menu.is-open .nav__item:nth-child(5) { transition-delay: 0.3s; }

  #nav-menu.is-open .social-menu {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    #nav-menu, #nav-menu.is-open .nav__item, #nav-menu.is-open .social-menu {
      transition: opacity 0.3s ease;
      clip-path: none;
      transform: none;
    }
  }

  /* --- Header Scroll Behavior --- */
  #main-header {
    transition: transform 0.35s ease, height 0.3s ease, box-shadow 0.3s ease;
  }
  #main-header.is-hidden {
    transform: translateY(-100%);
  }

  /* --- Scroll-spy active link --- */
  .nav-link.is-active {
    color: #000;
  }
  .nav-link.is-active::after {
    width: 100%;
  }
</style>

<script>
  const floatingBtn = document.getElementById('floating-reserve');
  const header = document.getElementById('main-header');
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const navMenu = document.getElementById('nav-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');

  /* --- Hide-on-scroll logic --- */
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;

    if (y > 20) {
      header?.classList.add('shadow-sm', 'h-16');
      header?.classList.remove('h-20');
    } else {
      header?.classList.add('h-20');
      header?.classList.remove('shadow-sm', 'h-16');
    }

  
  }, { passive: true });

  /* --- Mobile Menu Logic --- */
  if (hamburgerBtn && navMenu) {
    // Guardamos la posición de scroll para el lock real del body
    let scrollY = 0;

    const close = () => {
      navMenu.classList.remove('is-open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      // Transforma X -> Hamburguesa
      line1?.classList.remove('rotate-45', 'translate-y-[3.5px]');
      line2?.classList.remove('-rotate-45', '-translate-y-[4px]');

      // Restauramos el scroll del body (lock real, no solo overflow-hidden)
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.classList.remove('overflow-hidden');
      window.scrollTo(0, scrollY);

      floatingBtn?.classList.remove('is-hidden');
    };

    const open = () => {
      scrollY = window.scrollY;
      navMenu.classList.add('is-open');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      // Transforma Hamburguesa -> X
      line1?.classList.add('rotate-45', 'translate-y-[3.5px]');
      line2?.classList.add('-rotate-45', '-translate-y-[4px]');

      // Fijamos el body en su posición actual para bloquear el scroll de verdad
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.classList.add('overflow-hidden');

      floatingBtn?.classList.add('is-hidden');
    };

    hamburgerBtn.addEventListener('click', () => {
      navMenu.classList.contains('is-open') ? close() : open();
    });

    mobileLinks.forEach((link) => link.addEventListener('click', close));
  }

  /* --- Scroll-spy --- */
  const sections = document.querySelectorAll('main section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  if (sections.length && navLinks.length) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            const match = link.getAttribute('data-nav-link') === entry.target.id;
            link.classList.toggle('is-active', match);
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );

    sections.forEach((section) => spyObserver.observe(section));
  }
</script>