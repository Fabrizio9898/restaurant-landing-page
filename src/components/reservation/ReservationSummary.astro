---
// Paso 3: resumen de la reserva con subtotal, descuento y total.
// Los valores se actualizan en cliente desde el store.
interface Props {
	discountPercent: number;
}

const { discountPercent } = Astro.props;
---

<div class="rv-summary">
	<p class="rv-step-label">Paso 3 · Resumen</p>
	<h2>Resumen de la reserva</h2>

	<dl class="rv-summary-details">
		<dt>Fecha</dt>
		<dd id="rv-summary-date">—</dd>
		<dt>Horario</dt>
		<dd id="rv-summary-time">—</dd>
		<dt>Personas</dt>
		<dd id="rv-summary-party">—</dd>
		<dt>Contacto</dt>
		<dd id="rv-summary-customer">—</dd>
	</dl>

	<h3>Platos</h3>
	<ul id="rv-summary-items"></ul>

	<dl class="rv-summary-totals">
		<dt>Subtotal</dt>
		<dd id="rv-subtotal">—</dd>
		<dt>Descuento reserva ({discountPercent}%)</dt>
		<dd id="rv-discount">—</dd>
		<dt>Total</dt>
		<dd id="rv-total">—</dd>
	</dl>

	<div class="rv-actions">
		<button type="button" data-action="back-to-dishes">Atrás</button>
		<button type="button" data-action="continue-payment">Ir a pagar</button>
	</div>
</div>
