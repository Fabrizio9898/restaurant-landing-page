---
// Paso 1: datos de la reserva y datos de contacto del cliente.
// Estructura estática; el wiring (reservationFlow.ts) enlaza inputs y validación.
---

<div class="rv-form">
	<p class="rv-step-label">Paso 1 · Datos de la reserva</p>
	<h2>Datos de la reserva</h2>

	<div class="rv-field">
		<label for="rv-date">Fecha</label>
		<input id="rv-date" name="date" type="date" required />
	</div>
	<div class="rv-field">
		<label for="rv-time">Horario</label>
		<input id="rv-time" name="time" type="time" required />
	</div>
	<div class="rv-field">
		<label for="rv-party-size">Personas</label>
		<input id="rv-party-size" name="partySize" type="number" min="1" step="1" value="2" required />
	</div>

	<fieldset class="rv-fieldset">
		<legend>Datos de contacto</legend>
		<div class="rv-field">
			<label for="rv-name">Nombre</label>
			<input id="rv-name" name="name" type="text" autocomplete="name" required />
		</div>
		<div class="rv-field">
			<label for="rv-phone">Teléfono</label>
			<input id="rv-phone" name="phone" type="tel" autocomplete="tel" required />
		</div>
		<div class="rv-field">
			<label for="rv-email">Email</label>
			<input id="rv-email" name="email" type="email" autocomplete="email" required />
		</div>
	</fieldset>

	<p id="rv-form-errors" role="alert" hidden></p>

	<div class="rv-actions">
		<button type="button" data-action="continue-details">Continuar</button>
	</div>
</div>
