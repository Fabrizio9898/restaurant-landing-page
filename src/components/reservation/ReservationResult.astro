---
// Resultado final del flujo: éxito o error de la reserva.
---

<div class="rv-result">
	<div id="rv-result-success" hidden>
		<p class="rv-step-label">Reserva confirmada</p>
		<h2>¡Reserva confirmada!</h2>
		<p>
			Tu reserva fue registrada. Código: <strong id="rv-result-id">—</strong>
		</p>
		<div class="rv-actions">
			<button type="button" data-action="new-reservation">Nueva reserva</button>
		</div>
	</div>

	<div id="rv-result-error" hidden>
		<p class="rv-step-label">Error</p>
		<h2>No pudimos completar la reserva</h2>
		<p id="rv-result-error-message" role="alert"></p>
		<div class="rv-actions">
			<button type="button" data-action="retry">Reintentar</button>
		</div>
	</div>
</div>
