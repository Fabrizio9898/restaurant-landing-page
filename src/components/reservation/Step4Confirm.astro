---
// Paso 4: confirmación final + resultado.
---

<div class="rv-step" data-step="step4" hidden>
	<div id="rv-confirm-view" hidden>
		<button type="button" class="rv-back-btn" data-action="go-back">← Volver</button>
		<p class="rv-step-label">Confirmar</p>
		<h2 class="rv-step-title">Resumen de tu reserva</h2>

		<dl class="rv-confirm-dl">
			<dt>Fecha</dt>
			<dd id="rv-confirm-date">—</dd>
			<dt>Horario</dt>
			<dd id="rv-confirm-time">—</dd>
			<dt>Zona</dt>
			<dd id="rv-confirm-zone">—</dd>
			<dt>Personas</dt>
			<dd id="rv-confirm-party">—</dd>
			<dt>Contacto</dt>
			<dd id="rv-confirm-customer">—</dd>
		</dl>

		<div id="rv-confirm-menu-section" hidden>
			<h3 class="rv-confirm-menu-title">Menú seleccionado</h3>
			<ul id="rv-confirm-items"></ul>
			<dl class="rv-confirm-totals">
				<dt>Subtotal</dt>
				<dd id="rv-confirm-subtotal">—</dd>
				<dt>Descuento (10%)</dt>
				<dd id="rv-confirm-discount">—</dd>
				<dt>Total</dt>
				<dd id="rv-confirm-total">—</dd>
			</dl>
		</div>

		<p class="rv-form-error" id="rv-submit-error" role="alert" hidden></p>

		<div class="rv-actions">
			<button type="button" class="btn btn-outline" data-action="submit-reservation" id="rv-submit-btn">
				Confirmar reserva
			</button>
		</div>
	</div>

	<div id="rv-result-success" hidden>
		<p class="rv-step-label">¡Reserva confirmada!</p>
		<h2 class="rv-step-title">Tu mesa está reservada</h2>
		<p>Código: <strong id="rv-result-id">—</strong></p>
		<div id="rv-result-summary" class="rv-result-summary"></div>
		<div class="rv-actions">
			<button type="button" class="btn" data-action="new-reservation">Nueva reserva</button>
		</div>
	</div>

	<div id="rv-result-failure" hidden>
		<p class="rv-step-label">Pago no completado</p>
		<h2 class="rv-step-title">No pudimos procesar el pago</h2>
		<p id="rv-result-failure-msg">El pago fue cancelado o no se completó.</p>
		<div class="rv-actions">
			<button type="button" class="btn btn-outline" data-action="new-reservation">Intentar de nuevo</button>
		</div>
	</div>
</div>
