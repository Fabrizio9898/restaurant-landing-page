---
// Paso 2: selección opcional de platos con descuento de reserva.
// La lista de platos (#rv-dish-list) se renderiza en cliente desde el store.
interface Props {
	discountPercent: number;
}

const { discountPercent } = Astro.props;
---

<div class="rv-dishes">
	<p class="rv-step-label">Paso 2 · Platos (opcional)</p>
	<h2>Elegí tus platos</h2>
	<p>Los platos seleccionados reciben un {discountPercent}% de descuento.</p>

	<p id="rv-dish-loading" hidden>Cargando carta…</p>
	<p id="rv-dish-error" role="alert" hidden></p>
	<ul id="rv-dish-list" hidden></ul>

	<div class="rv-actions">
		<button type="button" data-action="back-to-details">Atrás</button>
		<button type="button" data-action="continue-summary">Ver resumen</button>
	</div>
</div>
