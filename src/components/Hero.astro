---
import { site } from '../data/site';

// 1. Importamos la imagen correctamente para que Astro la pueda procesar
import fondoImg from '../assets/fondo.webp';
---

<section id="hero" class="relative h-screen w-full overflow-hidden">
  
  <!-- Imagen de fondo estática -->
  <img
    src={fondoImg.src}
    alt={site.name}
    class="absolute inset-0 h-full w-full object-cover"
  />




 <div class="relative z-10 w-full h-full flex flex-col items-center justify-center px-6 md:px-12 text-center mx-auto gap-8 ">

    <h1 class="animate-fade-in flex flex-col items-center justify-center font-serif text-[#0c1e30] w-full">
      
      <!-- Portales -->
      <span class="text-[clamp(2.25rem,10vw,6rem)] font-light uppercase tracking-widest leading-none whitespace-nowrap">
        Portales
      </span>
      
      <!-- de -->
      <span class="text-xl md:text-3xl font-light italic text-(--color-gold-light) my-2 md:my-4 lowercase tracking-[0.2em]">
        de
      </span>
      
      <!-- Uribelarrea (Ligeramente más chico en mobile por ser más larga) -->
      <span class="text-[clamp(1.75rem,8.5vw,6rem)] font-light uppercase tracking-widest leading-none whitespace-nowrap">
        Uribelarrea
      </span>

    </h1>
    
    <!-- Tagline (con line-clamp-2 para máximo 2 líneas) -->
    <p class="animate-fade-in-delayed w-full max-w-lg text-xs md:text-xl uppercase tracking-[0.3em] text-[#0c1e30] ">
      {site.tagline}
    </p>

  </div>


</section>

<style>
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
  .animate-fade-in-delayed {
    opacity: 0;
    animation: fadeIn 1s ease-out 0.3s forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>