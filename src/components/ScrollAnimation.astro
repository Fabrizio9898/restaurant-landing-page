---
// HeroOverlay.astro
---

<section class="hero-section">
  <figure class="image-container">
    <img 
      src="/photos/restaurant.avif" 
      alt="Ambiente del restaurante" 
      class="bg-image"
    />
  </figure>

  <div class="text-overlay">
    <h1 class="hero-title">
     Un espacio donde la gastronomía y los grandes momentos se encuentran.
    </h1>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimation() {
    const section = document.querySelector('.hero-section');
    const bgImage = document.querySelector('.bg-image');
    const textOverlay = document.querySelector('.text-overlay');

    if (!section || !bgImage || !textOverlay) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top bottom', 
        end: 'center center',   
        scrub: 0.5,
      }
    });

    // 1. Recorte de la imagen de 6% a 0%
    tl.fromTo(bgImage,
      { clipPath: 'polygon(6% 0%, 94% 0%, 94% 100%, 6% 100%)' },
      { clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)', ease: 'none' },
      0
    );

    // 2. Transición del texto: de sobresalir arriba a posicionarse dentro
    tl.fromTo(textOverlay,
      { y: '-60px' }, 
      { y: '200px', ease: 'none' }, 
      0
    );
  }

  document.addEventListener('astro:page-load', initAnimation);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', initAnimation);
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 80vh;
    margin: 4rem 0 0;
    display: flex;
    justify-content: center;
  }

  .image-container {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: clip-path;
  }

  .text-overlay {
    position: absolute;
    top: -10;
    z-index: 10;
    width: 90%;
    max-width: 900px;
    padding: 0 1rem;
    text-align: center;
    pointer-events: none;
    mix-blend-mode: exclusion; /* Efecto exacto de fusión/contraste visual */
    will-change: transform;
  }

  .hero-title {
    font-size: clamp(1.5rem, 3.5vw, 3.5rem);
    font-weight: 400;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 4px 15px rgba(0,0,0,0.6);
  }
</style>