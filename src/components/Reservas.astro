---
import { site } from '../data/site';
const { reservation } = site;
---

<section id="reservas" class="section-pad bg-[var(--color-wood-dark)] text-[var(--color-cream)] text-center" data-reveal>
  <div class="section-inner max-w-xl">
    <p class="section-label">Mesas</p>
    <h2 class="section-title text-[var(--color-cream)]">{reservation.title}</h2>
    <p class="mt-4 text-[var(--color-cream)]/75 leading-relaxed">{reservation.body}</p>
    <button type="button" class="btn btn-gold mt-8" data-reservation-trigger>
      {reservation.cta}
    </button>
  </div>
</section>
