---
import { site } from '../data/site';

// 1. Importamos la imagen correctamente para que Astro la pueda procesar
import fondoImg from '../assets/fondo.webp';
---

<section  class="hero-eventos">
  
  <div class="hero-texto-inferior">
 
    <h1 class="titulo">Eventos</h1>
  </div>

</section>

<style>
  .hero-eventos {
  position: relative;
  width: 100%;        
  height: 60vh;       
  min-height: 400px;  
  background-image: url('/photos/afuera.webp');
  background-size: cover;     
  background-position: center;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;   
  align-items: center;         
}

  .titulo {
    color: white;
    font-size: 4rem;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .titulo {
      font-size: 3rem; 
    }
  }
</style>