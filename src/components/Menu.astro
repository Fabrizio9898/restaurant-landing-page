---
import { site } from '../data/site';
const featured = site.menu.filter((i) => i.featured);
---

<section id="menu" class="section-pad bg-[var(--color-black)] text-[var(--color-cream)]" data-reveal>
  <div class="section-inner">
    <p class="section-label">Carta</p>
    <h2 class="section-title text-[var(--color-cream)]">Platos destacados</h2>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((item) => (
        <li class="border border-[var(--color-gold)]/25 p-6 hover:border-[var(--color-gold)]/60 transition-colors">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-serif text-xl text-[var(--color-gold-light)]">{item.name}</h3>
            <span class="text-sm text-[var(--color-gold)] whitespace-nowrap">{item.price}</span>
          </div>
          <p class="mt-3 text-sm text-[var(--color-cream)]/70 leading-relaxed">{item.description}</p>
        </li>
      ))}
    </ul>
    <div class="mt-12 text-center">
      <a
        href="/menu"
        class="inline-block border border-[var(--color-gold)]/50 px-8 py-3 text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] transition-all duration-300 hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
      >
        Ver carta completa
      </a>
    </div>
  </div>
</section>
