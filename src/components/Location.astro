---
import { site } from '../data/site';
const { location } = site;
---

<section id="location" class="section-pad bg-white" data-reveal>
  <div class="section-inner grid gap-10 lg:grid-cols-2">
    <div>
      <p class="section-label">Visitanos</p>
      <h2 class="section-title">Ubicación y horarios</h2>
      <p class="mt-6 text-[var(--color-wood-dark)]">{location.address}</p>
      <p class="mt-3 text-sm">
        <a href={`tel:${location.phone.replace(/\s/g, '')}`} class="hover:text-[var(--color-gold)]">{location.phone}</a>
      </p>
      <p class="mt-1 text-sm">
        <a href={`mailto:${location.email}`} class="hover:text-[var(--color-gold)]">{location.email}</a>
      </p>
      <ul class="mt-8 space-y-3 border-t border-[var(--color-wood)]/15 pt-6">
        {location.hours.map((h) => (
          <li class="flex justify-between gap-4 text-sm">
            <span class="font-medium">{h.days}</span>
            <span class="text-[var(--color-wood)]">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="min-h-72 border border-[var(--color-wood)]/20 overflow-hidden">
      <iframe
        title="Mapa Uribelarrea"
        src={location.mapEmbed}
        class="w-full h-full min-h-72"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
